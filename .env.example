# Copy to .env and fill in. .env is git-ignored.

# Required — Groq LLM inference (https://console.groq.com/keys)
GROQ_API_KEY=

# Required for web grounding — Tavily (https://app.tavily.com)
TAVILY_API_KEY=

# Optional — set to "true" to enable BGE cross-encoder reranking (extra model download)
USE_RERANKER=false
